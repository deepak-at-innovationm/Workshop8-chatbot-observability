# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Chat model. gpt-5-nano supports function calling.
# Temperature is left unset so the API applies the model's own default.
LLM_MODEL=gpt-5-nano

# IANA timezone used by get_current_datetime.
APP_TIMEZONE=Asia/Kolkata

# Maximum stored chat messages per session (user and assistant messages combined).
HISTORY_MAX_MESSAGES=10

# Controlled trace failure. Keep false for normal use.
# A failure is injected only when this is true AND the request sends
# the header X-Demo-Fault: model. Turning the flag on does not fail ordinary chats.
ALLOW_DEMO_FAULTS=false

# LangSmith tracing. The chatbot still runs when this is false and no API key is set.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mlops-chatbot-demo

# Optional. Leave empty to use the LangSmith default cloud endpoint.
LANGSMITH_ENDPOINT=
